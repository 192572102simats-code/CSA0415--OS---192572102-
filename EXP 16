
#include <stdio.h>

struct employee
{
    int id;
    char name[20];
    float salary;
};

int main()
{
    FILE *fp;
    struct employee e;
    int n, i, pos;

    fp = fopen("employee.dat", "wb+");

    printf("Enter number of employees: ");
    scanf("%d", &n);

    for(i = 0; i < n; i++)
    {
        printf("Enter ID, Name and Salary: ");
        scanf("%d %19s %f", &e.id, e.name, &e.salary);
        fwrite(&e, sizeof(e), 1, fp);
    }

    printf("Enter employee number to access: ");
    scanf("%d", &pos);

    if(pos >= 1 && pos <= n)
    {
        fseek(fp, (pos - 1) * sizeof(e), SEEK_SET);
        fread(&e, sizeof(e), 1, fp);

        printf("\nEmployee Details\n");
        printf("ID: %d\n", e.id);
        printf("Name: %s\n", e.name);
        printf("Salary: %.2f\n", e.salary);
    }
    else
        printf("Invalid employee number!\n");

    fclose(fp);
    return 0;
}
