
#include <stdio.h>

struct employee
{
    int id;
    char name[20];
    float salary;
};

int main()
{
    FILE *fp;
    struct employee e;
    int choice, n;

    fp = fopen("emp.dat", "wb+");

    if(fp == NULL)
    {
        printf("File cannot be opened");
        return 1;
    }

    printf("Enter number of employees: ");
    scanf("%d", &n);

    for(int i = 0; i < n; i++)
    {
        printf("Enter ID, name and salary: ");
        scanf("%d %19s %f", &e.id, e.name, &e.salary);
        fwrite(&e, sizeof(e), 1, fp);
    }

    printf("Enter employee number to search: ");
    scanf("%d", &choice);

    if(choice >= 1 && choice <= n)
    {
        fseek(fp, (choice - 1) * sizeof(e), SEEK_SET);
        fread(&e, sizeof(e), 1, fp);

        printf("\nEmployee Details\n");
        printf("ID = %d\n", e.id);
        printf("Name = %s\n", e.name);
        printf("Salary = %.2f\n", e.salary);
    }
    else
    {
        printf("Invalid employee number");
    }

    fclose(fp);
    return 0;
}
