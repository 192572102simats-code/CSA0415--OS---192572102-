#include <stdio.h>
#include <sys/ipc.h>
#include <sys/shm.h>
#include <sys/wait.h>
#include <unistd.h>

int main() {
    int id, *data;

    id = shmget(IPC_PRIVATE, sizeof(int), IPC_CREAT | 0666);
    data = (int *)shmat(id, NULL, 0);

    if (fork() == 0) {
        *data = 100;
        printf("Child writes: %d\n", *data);
        shmdt(data);
    } else {
        wait(NULL);
        printf("Parent reads: %d\n", *data);
        shmdt(data);
        shmctl(id, IPC_RMID, NULL);
    }

    return 0;
}
