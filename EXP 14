
#include <stdio.h>
#include <string.h>

int main()
{
    char files[10][20], name[20];
    int n = 0, choice, i, found;

    while(1)
    {
        printf("\n1. Create File");
        printf("\n2. Display Files");
        printf("\n3. Search File");
        printf("\n4. Exit");
        printf("\nEnter choice: ");
        scanf("%d", &choice);

        switch(choice)
        {
            case 1:
                printf("Enter file name: ");
                scanf("%19s", name);

                found = 0;
                for(i = 0; i < n; i++)
                {
                    if(strcmp(files[i], name) == 0)
                    {
                        found = 1;
                        break;
                    }
                }

                if(found)
                    printf("File already exists!\n");
                else if(n < 10)
                {
                    strcpy(files[n], name);
                    n++;
                    printf("File created successfully!\n");
                }
                else
                    printf("Directory is full!\n");
                break;

            case 2:
                printf("\nFiles in directory:\n");
                for(i = 0; i < n; i++)
                    printf("%s\n", files[i]);
                break;

            case 3:
                printf("Enter file name to search: ");
                scanf("%19s", name);

                found = 0;
                for(i = 0; i < n; i++)
                {
                    if(strcmp(files[i], name) == 0)
                    {
                        found = 1;
                        break;
                    }
                }

                if(found)
                    printf("File found!\n");
                else
                    printf("File not found!\n");
                break;

            case 4:
                return 0;

            default:
                printf("Invalid choice!\n");
        }
    }
}
