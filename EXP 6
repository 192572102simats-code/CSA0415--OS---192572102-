#include <stdio.h>

int main() {
    int n, i, time = 0, done = 0, p;
    int at[10], bt[10], rt[10], pr[10];
    int wt[10] = {0}, tat[10], ct[10];

    printf("Enter number of processes: ");
    scanf("%d", &n);

    for (i = 0; i < n; i++) {
        printf("Enter AT, BT and Priority of P%d: ", i + 1);
        scanf("%d%d%d", &at[i], &bt[i], &pr[i]);
        rt[i] = bt[i];
    }

    while (done < n) {
        p = -1;

        for (i = 0; i < n; i++) {
            if (at[i] <= time && rt[i] > 0) {
                if (p == -1 || pr[i] < pr[p])
                    p = i;
            }
        }

        if (p == -1) {
            time++;
            continue;
        }

        rt[p]--;
        time++;

        if (rt[p] == 0) {
            ct[p] = time;
            tat[p] = ct[p] - at[p];
            wt[p] = tat[p] - bt[p];
            done++;
        }
    }

    printf("\nPID\tWT\tTAT\n");
    for (i = 0; i < n; i++)
        printf("P%d\t%d\t%d\n", i + 1, wt[i], tat[i]);

    return 0;
}
